# Backend Java (service-scoped)
SPRING_PROFILES_ACTIVE=docker

# Database (Docker default)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/livecommerce
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# Redis (Docker default)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
# Base64-encoded 256-bit secret (change in real env!)
JWT_SECRET=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXo1Njc4OTA=
JWT_ACCESS_MS=900000
JWT_REFRESH_MS=1209600000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Local (non-Docker) hints ---
# If running Spring Boot directly on host, you can override to localhost:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/livecommerce
# REDIS_HOST=localhost
